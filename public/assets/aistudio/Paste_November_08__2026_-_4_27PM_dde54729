    if (!empty($callesCercanas)) {
        $prompt .= "Calles y vías adyacentes detectadas: [$callesCercanas]. ";
    }
    $prompt .= "Paso 1: Deduce de forma precisa el municipio, barrio y entorno urbano exacto correspondiente a estas coordenadas. "
        . "Paso 2: Genera entre 6 y 8 puntos de interés REALES y auténticos que existan en esta ciudad/barrio o que sean característicos de esta zona urbana concreta: "
        . "supermercados reales (Mercadona, Carrefour Market, Día, Aldi, etc.), farmacias reales de esa zona, centros de salud o ambulatorios reales del distrito, gasolineras (Repsol, Cepsa, etc.), comisarías o colegios/institutos públicos reales. "
        . "Paso 3: Prohibido usar etiquetas genéricas como 'Supermercado de Barrio' o 'Zona Urbana'. Usa nombres propios específicos y verosímiles. "
        . "Paso 4: Muy importante: para que aparezcan en el encuadre visual inmediato del usuario, sitúa sus coordenadas (lat, lng) muy cerca del punto base (a una distancia de entre 80 y 400 metros, es decir, variaciones de entre +/- 0.0008 y +/- 0.0035 respecto a $lat y $lng). "
        . "Responde únicamente con un array JSON sin texto explicativo ni formato markdown: "
        . "[{\"nombre\":\"Nombre Real Propio\",\"categoria\":\"Farmacia|Supermercado|Hospital|Refugio Amurallado|Combustible|Armería\",\"lat\":float,\"lng\":float,\"suministros\":\"víveres o medicinas concretas\",\"amenaza\":\"Bajo|Medio|Alto|Crítico\"}]";

    $raw = consultarGemini($prompt, $GEMINI_API_KEY, true);
    $items = json_decode($raw, true) ?: [];

    if (empty($items)) {
        $plantillas = [
            ['Farmacia 24h Central', 'Farmacia', 'Antibióticos, vendas y alcohol', 'Bajo', 0.0012, 0.0009],
            ['Supermercado de Abastos', 'Supermercado', 'Conservas, agua mineral y cerillas', 'Medio', -0.0014, 0.0011],
            ['Instituto Público del Barrio', 'Refugio Amurallado', 'Vallas metálicas, mantas y herramientas', 'Medio', 0.0019, -0.0015],
            ['Centro de Salud / Urgencias', 'Hospital', 'Sueros, gasas y material de cura', 'Alto', -0.0015, -0.0018],
            ['Estación de Servicio Repsol/Cepsa', 'Combustible', 'Bidones de gasolina y baterías', 'Alto', 0.0022, 0.0014],
            ['Comisaría de Policía del Distrito', 'Armería', 'Munición 9mm y equipo antidisturbios', 'Crítico', -0.0019, 0.0008]
        ];
        foreach ($plantillas as $p) {
            $items[] = [
                'nombre'      => $p[0],
                'categoria'   => $p[1],
                'suministros' => $p[2],
                'amenaza'     => $p[3],
                'lat'         => $lat + $p[4],
                'lng'         => $lng + $p[5]
            ];
        }
    }

    if ($pdo instanceof PDO && !empty($items)) {
        $stmt = $pdo->prepare("INSERT INTO zombie_pois (lat, lng, nombre, categoria, suministros, nivel_amenaza) VALUES (?, ?, ?, ?, ?, ?)");
        foreach ($items as $poi) {
            $stmt->execute([
                $poi['lat'],
                $poi['lng'],
                $poi['nombre'],
                $poi['categoria'],
                $poi['suministros'] ?? '',
                $poi['amenaza'] ?? 'Medio'
            ]);
        }
    }

    echo json_encode(['status' => 'ok', 'data' => $items]);
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['accion']) && $_POST['accion'] === 'avanzar_historia') {
    if (ob_get_length()) { ob_clean(); }
    header('Content-Type: application/json; charset=utf-8');

    $eleccionUsuario = trim($_POST['decision'] ?? 'Evaluar la situación y asegurar el perímetro inmediato');
    $estadoContexto  = $_POST['contexto'] ?? '{}';
    $sessionId       = trim($_POST['session_id'] ?? session_id());
    $latActual       = (float)($_POST['lat'] ?? 36.7213);
    $lngActual       = (float)($_POST['lng'] ?? -4.4214);

    try {
        $stmtH = $pdo->prepare("INSERT INTO zombie_huellas (session_id, lat, lng, accion) VALUES (?, ?, ?, ?)");
        $stmtH->execute([$sessionId, $latActual, $lngActual, $eleccionUsuario]);
    } catch (PDOException $e) {}

    $deltaCuadrante = 0.008;
    $huellasVecinas = [];
    try {
        $stmtV = $pdo->prepare("SELECT accion, creado_en, 
                ROUND(TIMESTAMPDIFF(MINUTE, creado_en, NOW()) / 60, 1) as horas_atras
                FROM zombie_huellas 
                WHERE session_id != ? 
                  AND lat BETWEEN ? AND ? 
                  AND lng BETWEEN ? AND ? 
                  AND creado_en >= NOW() - INTERVAL 72 HOUR 
                ORDER BY creado_en DESC LIMIT 4");
        $stmtV->execute([
            $sessionId,
            $latActual - $deltaCuadrante, $latActual + $deltaCuadrante,
            $lngActual - $deltaCuadrante, $lngActual + $deltaCuadrante
        ]);
        $huellasVecinas = $stmtV->fetchAll();
    } catch (PDOException $e) {}

    $promptNarrativo = "Eres el narrador de un libro interactivo de supervivencia zombie estilo Project Zomboid y The Road. "
        . "El usuario realiza esta acción: '$eleccionUsuario'.\n"
        . "Estado local del tablero y lugares cercanos detectados:\n$estadoContexto\n\n"
        . "RASTROS Y HUELLAS DEJADAS POR OTROS SUPERVIVIENTES EN ESTE SECTOR:\n"
        . json_encode($huellasVecinas, JSON_UNESCAPED_UNICODE) . "\n\n"
        . "Instrucciones obligatorias:\n"
        . "1. Escribe en segunda persona ('Observas...', 'Tus pasos te guían hacia...'). Prosa literaria tensa, directa y atmosférica (máximo 110 palabras).\n"
        . "2. Cita obligatoriamente y por su nombre auténtico los establecimientos y recintos presentes en los datos del tablero. Si hay huellas de otros jugadores, menciónalas en diferido en esos lugares específicos.\n"
        . "3. Ofrece exactamente 3 opciones tácticas para continuar.\n"
        . "4. Devuelve únicamente este JSON sin formato markdown ni texto extra:\n"
        . "{\n"
        . "  \"narracion\": \"Texto literario...\",\n"
        . "  \"opciones\": [\"Opción A\", \"Opción B\", \"Opción C\"],\n"
        . "  \"mover_jugador\": {\"desplazar\": true|false, \"hacia_poi\": \"nombre del POI o null\", \"delta_lat\": float, \"delta_lng\": float},\n"
        . "  \"reclutar_companero\": true|false,\n"
        . "  \"evento_alerta\": \"Frase corta para la consola\"\n"
        . "}";

    $raw = consultarGemini($promptNarrativo, $GEMINI_API_KEY, true);
    $narrativaData = json_decode($raw, true);

    if (!$narrativaData || empty($narrativaData['narracion'])) {
        $narrativaData = [
            "narracion" => "Avanzas entre los escombros de la calzada. En el suelo distingues pisadas recientes y una verja entreabierta con signos de haber sido forzada hace escasas horas.",
            "opciones" => [
                "Examinar el interior del edificio abierto",
                "Seguir el rastro de huellas en el asfalto",
                "Ocultarte y vigilar los accesos"
            ],
            "mover_jugador" => ["desplazar" => false, "hacia_poi" => null, "delta_lat" => 0, "delta_lng" => 0],
            "reclutar_companero" => false,
            "evento_alerta" => "Vestigios de otros supervivientes identificados en el cuadrante."
        ];
    }

    echo json_encode(['status' => 'ok', 'data' => $narrativaData]);
    exit;
}
