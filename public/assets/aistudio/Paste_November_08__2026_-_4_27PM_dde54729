        $('#btn-toggle-console').on('click', function() {
            const $drawer = $('#console-drawer');
            const $arrow = $('#console-arrow');
            $drawer.toggleClass('hidden');
            $arrow.toggleClass('fa-chevron-up fa-chevron-down');
        });

        function descargarRedCalles(lat, lng) {
            $('#loader-status').text("Trazando viales locales de la zona...");
            registrarEvento("Trazando viales locales con OpenStreetMap...", "text-yellow-400");
            const radio = 0.005;
            const bbox = `${lat - radio},${lng - radio},${lat + radio},${lng + radio}`;
            
            const queryOverpass = `[out:json][timeout:15];way["highway"~"primary|secondary|tertiary|residential|pedestrian"](${bbox});out body;>;out skel qt;`;

            $.ajax({
                url: 'https://overpass-api.de/api/interpreter',
                type: 'POST',
                data: { data: queryOverpass },
                dataType: 'json',
                success: function(osm) {
                    redVial = {};
                    let nodosTemporales = {};
                    let nombresCalles = new Set();

                    osm.elements.forEach(el => {
                        if (el.type === 'node') {
                            nodosTemporales[el.id] = { lat: el.lat, lng: el.lon, vecinos: [] };
                        }
                        if (el.type === 'way' && el.tags && el.tags.name) {
                            nombresCalles.add(el.tags.name);
                        }
                    });

                    osm.elements.forEach(el => {
                        if (el.type === 'way' && el.nodes && el.nodes.length > 1) {
                            for (let i = 0; i < el.nodes.length - 1; i++) {
                                let n1 = el.nodes[i];
                                let n2 = el.nodes[i + 1];
                                if (nodosTemporales[n1] && nodosTemporales[n2]) {
                                    if (!redVial[n1]) redVial[n1] = nodosTemporales[n1];
                                    if (!redVial[n2]) redVial[n2] = nodosTemporales[n2];
                                    if (!redVial[n1].vecinos.includes(n2)) redVial[n1].vecinos.push(n2);
                                    if (!redVial[n2].vecinos.includes(n1)) redVial[n2].vecinos.push(n1);
                                }
                            }
                        }
                    });

                    listaNodosIds = Object.keys(redVial);
                    if (listaNodosIds.length > 0) {
                        registrarEvento(`Red vial activa: ${listaNodosIds.length} intersecciones conectadas.`, "text-emerald-400");
                        generarSupervivientes(5);
                        generarZombies(10);
                        iniciarSimulacionAutomatica();
                        ejecutarEscaneo(Array.from(nombresCalles).slice(0, 6).join(', '));
                    } else {
                        crearMallaVialEmergencia(lat, lng);
                        ejecutarEscaneo("");
                    }
                },
                error: function() {
                    registrarEvento("Red Overpass lenta. Activando soporte de viales directos.", "text-amber-400");
                    crearMallaVialEmergencia(lat, lng);
                    ejecutarEscaneo("");
                }
            });
        }

        function crearMallaVialEmergencia(lat, lng) {
            redVial = {};
            let idx = 0;
            const pasos = 5;
            const delta = 0.0012;
            for (let i = -pasos; i <= pasos; i++) {
                for (let j = -pasos; j <= pasos; j++) {
                    let id = "grid_" + idx++;
                    redVial[id] = { lat: lat + i * delta, lng: lng + j * delta, vecinos: [] };
                }
            }
            listaNodosIds = Object.keys(redVial);
            listaNodosIds.forEach(id => {
                let n = redVial[id];
                listaNodosIds.forEach(otroId => {
                    if (id !== otroId) {
                        let d = Math.hypot(n.lat - redVial[otroId].lat, n.lng - redVial[otroId].lng);
                        if (d < delta * 1.25) n.vecinos.push(otroId);
                    }
                });
            });
            generarSupervivientes(5);
            generarZombies(10);
            iniciarSimulacionAutomatica();
        }

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(pos) {
                coordsUsuario = [pos.coords.latitude, pos.coords.longitude];
                map.setView(coordsUsuario, 16);
                marcadorJugador.setLatLng(coordsUsuario);
                map.invalidateSize();
                registrarEvento("GPS fijado: " + coordsUsuario[0].toFixed(4) + ", " + coordsUsuario[1].toFixed(4), "text-emerald-400");
                descargarRedCalles(coordsUsuario[0], coordsUsuario[1]);
            }, function() {
                registrarEvento("Sin permiso de GPS. Asignando posición base.", "text-amber-400");
                map.invalidateSize();
                descargarRedCalles(coordsUsuario[0], coordsUsuario[1]);
            }, { timeout: 3500 });
        } else {
            descargarRedCalles(coordsUsuario[0], coordsUsuario[1]);
        }

        function iconoCategoria(cat) {
            let ico = 'fa-campground';
            let color = '#f59e0b';
            if (cat.indexOf('Farmacia') !== -1) { ico = 'fa-notes-medical'; color = '#10b981'; }
            else if (cat.indexOf('Hospital') !== -1) { ico = 'fa-square-h'; color = '#06b6d4'; }
            else if (cat.indexOf('Supermercado') !== -1) { ico = 'fa-basket-shopping'; color = '#84cc16'; }
            else if (cat.indexOf('Armería') !== -1) { ico = 'fa-gun'; color = '#ef4444'; }
            else if (cat.indexOf('Refugio') !== -1) { ico = 'fa-shield-halved'; color = '#8b5cf6'; }
            else if (cat.indexOf('Combustible') !== -1) { ico = 'fa-gas-pump'; color = '#f97316'; }

            return L.divIcon({
                className: 'marker-poi',
                html: `<div style="background:#0c0a09; border:2px solid ${color}; color:${color}; width:32px; height:32px; border-radius:6px; display:flex; align-items:center; justify-content:center; box-shadow:0 0 10px ${color}88;">
                        <i class="fa-solid ${ico}"></i>
                       </div>`,
                iconSize: [32, 32],
                iconAnchor: [16, 16]
            });
        }

        function ejecutarEscaneo(callesTexto = '') {
            $('#loader-status').text("Localizando supervivientes e instalaciones clave...");
            registrarEvento("Sondeando comercios e instalaciones reales con Gemini...", "text-yellow-400");
            $.ajax({
                url: window.location.pathname,
                type: 'POST',
                data: {
                    accion: 'escanear_radar',
                    lat: coordsUsuario[0],
                    lng: coordsUsuario[1],
                    calles_entorno: callesTexto
                },
                dataType: 'json',
                success: function(res) {
                    if (res.status === 'ok') {
                        pois = res.data;
                        $('#stat-pois').text(pois.length);
                        pois.forEach(p => {
                            let m = L.marker([p.lat, p.lng], { icon: iconoCategoria(p.categoria) }).addTo(map);
                            m.bindPopup(`
                                <div class="text-xs font-mono">
                                    <b class="text-red-500 uppercase">${p.nombre}</b><br>
                                    <span class="text-stone-400">Tipo:</span> ${p.categoria}<br>
                                    <span class="text-stone-400">Peligro:</span> <b class="text-amber-400">${p.amenaza}</b><br>
                                    <span class="text-stone-400">Botín:</span> ${p.suministros}
                                </div>
                            `);
                        });
                        registrarEvento(`Radar completado: ${pois.length} zonas de interés tácticas localizadas.`, "text-emerald-400");
                        avanzarCapituloHistoria("Iniciar reconocimiento del sector");
                    }
                }
            });
        }

        function generarSupervivientes(cant) {
            if (listaNodosIds.length === 0) return;
            for (let i = 0; i < cant; i++) {
                let nodoId = listaNodosIds[Math.floor(Math.random() * listaNodosIds.length)];
                let nodo = redVial[nodoId];
                let m = L.marker([nodo.lat, nodo.lng], {
                    icon: L.divIcon({
                        className: 'survivor-node',
                        html: '<i class="fa-solid fa-person-running fa-lg"></i>',
                        iconSize: [22, 22]
                    })
                }).addTo(map);

                supervivientes.push({ marker: m, nodoActual: nodoId, reclutado: false });
            }
            $('#stat-survivors').text(supervivientes.length);
        }

        function generarZombies(cant) {
            if (listaNodosIds.length === 0) return;
            for (let i = 0; i < cant; i++) {
                let nodoId = listaNodosIds[Math.floor(Math.random() * listaNodosIds.length)];
                let nodo = redVial[nodoId];
                let m = L.marker([nodo.lat, nodo.lng], {
                    icon: L.divIcon({
                        className: 'zombie-node',
                        html: '<i class="fa-solid fa-biohazard fa-lg"></i>',
                        iconSize: [22, 22]
                    })
                }).addTo(map);

                zombies.push({ marker: m, nodoActual: nodoId });
            }
            $('#stat-zombies').text(zombies.length);
        }

        function cicloDiezSegundos() {
            const RANGO_DETECCION = 0.0035;
            const RADIO_MAX_OPERATIVO = 0.0045;

            function filtrarVecinosEnRadio(nodo, latCentro, lngCentro) {
                let permitidos = nodo.vecinos.filter(vId => {
                    let v = redVial[vId];
                    return v && Math.hypot(v.lat - latCentro, v.lng - lngCentro) <= RADIO_MAX_OPERATIVO;
                });
                return permitidos.length > 0 ? permitidos : nodo.vecinos;
            }

            supervivientes.forEach(s => {
                let nodoActual = redVial[s.nodoActual];
                if (!nodoActual || !nodoActual.vecinos || nodoActual.vecinos.length === 0) return;

                let distCentro = Math.hypot(nodoActual.lat - coordsUsuario[0], nodoActual.lng - coordsUsuario[1]);
                if (distCentro > RADIO_MAX_OPERATIVO) {
                    let nodoRetorno = listaNodosIds.find(id => {
                        let n = redVial[id];
                        return Math.hypot(n.lat - coordsUsuario[0], n.lng - coordsUsuario[1]) < RADIO_MAX_OPERATIVO * 0.5;
                    });
                    if (nodoRetorno) {
                        s.nodoActual = nodoRetorno;
                        s.marker.setLatLng([redVial[nodoRetorno].lat, redVial[nodoRetorno].lng]);
                        return;
                    }
                }

                let vecinosValidos = filtrarVecinosEnRadio(nodoActual, coordsUsuario[0], coordsUsuario[1]);
                let amenazaDetectada = false;

                zombies.forEach(z => {
                    let zNodo = redVial[z.nodoActual];
                    if (zNodo && Math.hypot(nodoActual.lat - zNodo.lat, nodoActual.lng - zNodo.lng) < RANGO_DETECCION) {
                        amenazaDetectada = true;
                    }
                });

                let siguiente = null;
                if (s.reclutado) {
                    let minDistJugador = Infinity;
                    vecinosValidos.forEach(vId => {
                        let vNodo = redVial[vId];
                        let d = Math.hypot(vNodo.lat - coordsUsuario[0], vNodo.lng - coordsUsuario[1]);
                        if (d < minDistJugador) {
                            minDistJugador = d;
                            siguiente = vId;
                        }
                    });
                } else if (amenazaDetectada) {
                    let maxDistAmenaza = -Infinity;
                    vecinosValidos.forEach(vId => {
                        let vNodo = redVial[vId];
                        let minDistZombie = Infinity;
                        zombies.forEach(z => {
                            let zNodo = redVial[z.nodoActual];
                            if (zNodo) {
                                let d = Math.hypot(vNodo.lat - zNodo.lat, vNodo.lng - zNodo.lng);
                                if (d < minDistZombie) minDistZombie = d;
                            }
                        });
                        if (minDistZombie > maxDistAmenaza) {
                            maxDistAmenaza = minDistZombie;
                            siguiente = vId;
                        }
                    });
                } else {
                    siguiente = vecinosValidos[Math.floor(Math.random() * vecinosValidos.length)];
                }

                if (siguiente && redVial[siguiente]) {
                    s.nodoActual = siguiente;
                    s.marker.setLatLng([redVial[siguiente].lat, redVial[siguiente].lng]);
                }
            });

            for (let i = zombies.length - 1; i >= 0; i--) {
                let z = zombies[i];
                let nodoActual = redVial[z.nodoActual];
                if (!nodoActual || !nodoActual.vecinos || nodoActual.vecinos.length === 0) continue;

                let distCentro = Math.hypot(nodoActual.lat - coordsUsuario[0], nodoActual.lng - coordsUsuario[1]);
                if (distCentro > RADIO_MAX_OPERATIVO) {
                    let nodoRetorno = listaNodosIds.find(id => {
                        let n = redVial[id];
                        return Math.hypot(n.lat - coordsUsuario[0], n.lng - coordsUsuario[1]) < RADIO_MAX_OPERATIVO * 0.6;
                    });
                    if (nodoRetorno) {
                        z.nodoActual = nodoRetorno;
                        z.marker.setLatLng([redVial[nodoRetorno].lat, redVial[nodoRetorno].lng]);
                        continue;
                    }
                }

                let vecinosValidos = filtrarVecinosEnRadio(nodoActual, coordsUsuario[0], coordsUsuario[1]);
                let presas = [...supervivientes.map(s => ({ lat: redVial[s.nodoActual].lat, lng: redVial[s.nodoActual].lng, ref: s }))];
                presas.push({ lat: coordsUsuario[0], lng: coordsUsuario[1], ref: 'jugador' });

                let presaDetectada = null;
                let minDistPresa = Infinity;

                presas.forEach(p => {
                    let d = Math.hypot(nodoActual.lat - p.lat, nodoActual.lng - p.lng);
                    if (d < RANGO_DETECCION && d < minDistPresa) {
                        minDistPresa = d;
                        presaDetectada = p;
                    }
                });

                let siguiente = null;
                if (presaDetectada) {
                    let menorDistRuta = Infinity;
                    vecinosValidos.forEach(vId => {
                        let vNodo = redVial[vId];
                        let d = Math.hypot(vNodo.lat - presaDetectada.lat, vNodo.lng - presaDetectada.lng);
                        if (d < menorDistRuta) {
                            menorDistRuta = d;
                            siguiente = vId;
                        }
                    });
                } else {
                    siguiente = vecinosValidos[Math.floor(Math.random() * vecinosValidos.length)];
                }

                if (siguiente && redVial[siguiente]) {
                    z.nodoActual = siguiente;
                    z.marker.setLatLng([redVial[siguiente].lat, redVial[siguiente].lng]);
                }

                for (let j = supervivientes.length - 1; j >= 0; j--) {
                    if (supervivientes[j].nodoActual === z.nodoActual) {
                        let victima = supervivientes[j];
                        map.removeLayer(victima.marker);
                        supervivientes.splice(j, 1);
                        contadorBajas++;

                        let nuevoZombie = L.marker([redVial[z.nodoActual].lat, redVial[z.nodoActual].lng], {
                            icon: L.divIcon({
                                className: 'zombie-node',
                                html: '<i class="fa-solid fa-biohazard fa-lg"></i>',
                                iconSize: [22, 22]
                            })
                        }).addTo(map);

                        zombies.push({ marker: nuevoZombie, nodoActual: z.nodoActual });

                        $('#stat-survivors').text(supervivientes.length);
                        $('#stat-zombies').text(zombies.length);
                        $('#stat-deaths').text(contadorBajas);
                        registrarEvento("¡Ataque en cruce de calles! Superviviente asimilado por la horda.", "text-rose-500 font-bold");
                        break;
                    }
                }
            }
        }

        function iniciarSimulacionAutomatica() {
            if (simIniciada) return;
            simIniciada = true;
            cicloDiezSegundos();
            setInterval(cicloDiezSegundos, 10000);
            registrarEvento("Simulación iniciada: patrulla táctica de calles cada 10 segundos.", "text-emerald-400");
        }

        function avanzarCapituloHistoria(decisionTomada) {
            detenerAudio();
            $('#narrativa-opciones').html('<div class="col-span-3 text-center py-2 text-amber-500"><i class="fa-solid fa-compass fa-spin mr-2"></i>La pluma escribe tu destino...</div>');

            let contextoTablero = {
                jugador: { lat: coordsUsuario[0], lng: coordsUsuario[1] },
                aliados: companeros.length,
                total_supervivientes: supervivientes.length,
                total_zombies: zombies.length,
                pois_cercanos: pois.slice(0, 6).map(p => ({ nombre: p.nombre, categoria: p.categoria, amenaza: p.amenaza }))
            };

            $.ajax({
                url: window.location.pathname,
                type: 'POST',
                data: {
                    accion: 'avanzar_historia',
                    decision: decisionTomada,
                    contexto: JSON.stringify(contextoTablero),
                    session_id: playerSessionId,
                    lat: coordsUsuario[0],
                    lng: coordsUsuario[1]
                },
                dataType: 'json',
                success: function(res) {
                    if (res.status === 'ok') {
                        let data = res.data;
                        $('#narrativa-texto').html(`"${data.narracion}"`);

                        let locucionCompleta = data.narracion + ". ";
                        if (data.opciones && data.opciones.length > 0) {
                            locucionCompleta += "¿Qué decides hacer a continuación? ";
                            data.opciones.forEach((opc, idx) => {
                                locucionCompleta += `Opción ${idx + 1}: ${opc}. `;
                            });
                        }
                        leerTexto(locucionCompleta);

                        if (data.evento_alerta) {
                            registrarEvento(data.evento_alerta, "text-amber-400 font-semibold");
                        }

                        if (data.reclutar_companero && supervivientes.length > 0) {
                            let candidato = supervivientes.find(s => !s.reclutado);
                            if (candidato) {
                                candidato.reclutado = true;
                                companeros.push(candidato);
                                candidato.marker.setIcon(L.divIcon({
                                    className: 'companion-node',
                                    html: '<i class="fa-solid fa-person-circle-check fa-lg"></i>',
                                    iconSize: [22, 22]
                                }));
                                $('#badge-companero').removeClass('hidden').html(`<i class="fa-solid fa-user-group mr-1"></i>Aliados: ${companeros.length}`);
                                registrarEvento("¡Nuevo aliado! Un civil se une a tu grupo táctico.", "text-sky-400 font-bold");
                            }
                        }

                        if (data.mover_jugador && data.mover_jugador.desplazar) {
                            let latAnterior = Number(coordsUsuario[0]);
                            let lngAnterior = Number(coordsUsuario[1]);
                            let nuevaLat = latAnterior;
                            let nuevaLng = lngAnterior;

                            if (data.mover_jugador.hacia_poi && pois.length > 0) {
                                let busqueda = data.mover_jugador.hacia_poi.toLowerCase();
                                let destinoPoi = pois.find(p => p.nombre.toLowerCase().includes(busqueda) || busqueda.includes(p.nombre.toLowerCase()));
                                if (destinoPoi) {
                                    nuevaLat = Number(destinoPoi.lat);
                                    nuevaLng = Number(destinoPoi.lng);
                                }
                            } else if (data.mover_jugador.delta_lat || data.mover_jugador.delta_lng) {
                                nuevaLat += Number(data.mover_jugador.delta_lat || 0);
                                nuevaLng += Number(data.mover_jugador.delta_lng || 0);
                            }

                            if (!isNaN(nuevaLat) && !isNaN(nuevaLng) && (nuevaLat !== latAnterior || nuevaLng !== lngAnterior)) {
                                let tramoRuta = L.polyline([[latAnterior, lngAnterior], [nuevaLat, nuevaLng]], {
                                    color: '#38bdf8',
                                    weight: 3,
                                    opacity: 0.85,
                                    dashArray: '4, 6',
                                    lineCap: 'round'
                                }).addTo(map);

                                estelasJugador.push(tramoRuta);

                                setTimeout(() => {
                                    map.removeLayer(tramoRuta);
                                    let idx = estelasJugador.indexOf(tramoRuta);
                                    if (idx > -1) estelasJugador.splice(idx, 1);
                                }, 30000);

                                coordsUsuario = [nuevaLat, nuevaLng];
                                marcadorJugador.setLatLng(coordsUsuario);
                                if (marcadorJugador.bringToFront) {
                                    marcadorJugador.bringToFront();
                                }
                                map.panTo(coordsUsuario, { animate: true, duration: 1.2 });
                            }
                        }

                        let $opcionesCont =$('#narrativa-opciones').empty();
                        data.opciones.forEach((opc) => {
                            let $btn =$(`<button class="bg-black/40 hover:bg-stone-800/60 border border-stone-700/60 hover:border-amber-500 text-stone-200 hover:text-amber-300 py-2 px-3 rounded text-[11px] text-left transition leading-snug shadow backdrop-blur-sm">
                                <i class="fa-solid fa-angle-right text-amber-500 mr-1.5"></i>${opc}
                            </button>`);
                            $btn.on('click', function() {
                                avanzarCapituloHistoria(opc);
                            });
                            $opcionesCont.append($btn);
                        });

                        primerCapituloListo = true;
                        if (tiempoMinimoCumplido) {
                            clearTimeout(tiempoMaximoSeguridad);
                            revelarInterfaz();
                        }
                    }
                },
                error: function() {
                    $('#narrativa-opciones').html('<div class="col-span-3 text-rose-500 text-xs text-center">Fallo de comunicación con la bitácora.</div>');
                    revelarInterfaz();
                }
            });
        }
    });
    </script>
